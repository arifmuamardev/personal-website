---
import { isProfileAuthor } from '../lib/publication-reference';

interface Props {
  authors: readonly string[];
}

const { authors } = Astro.props;

---

<span class="publication-authors">
  {authors.map((author, index) => (
    <>
      {isProfileAuthor(author) ? <strong class="profile-author">{author}</strong> : author}
      {index < authors.length - 1 ? ', ' : ''}
    </>
  ))}
</span>
<style>
  .profile-author {font-weight:750;color:var(--text-primary);}
</style>
