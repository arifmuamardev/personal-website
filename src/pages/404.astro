---
import Layout from '../layouts/Layout.astro';
import { localPath } from '../lib/urls';
---

<Layout title="Page Not Found" noindex>
  <section class="section error-section">
    <div class="container error-container">
      <div class="error-code">404</div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-message">
        Sorry, the page you are looking for does not exist or has been moved to a new address.
      </p>
      <div class="error-cta">
        <a href={localPath('/')} class="btn btn-primary">Return to Homepage</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-section {
    padding: 8rem 0;
    text-align: center;
  }
  
  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 500px;
  }
  
  .error-code {
    font-size: 8rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-color);
    background: linear-gradient(135deg, var(--accent-color), hsl(210, 40%, 25%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    letter-spacing: -0.05em;
  }
  
  .error-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .error-message {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.5;
  }
  
  .error-cta {
    display: flex;
    justify-content: center;
  }
</style>
