---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import AcademicProfileNav from '../components/AcademicProfileNav.astro';
import { localPath } from '../lib/urls';
import { profile } from '../data/profile';
---
<Layout
  title="About"
  description="Academic biography of Arif Mu'amar Wahid, with dedicated pages for education, experience, teaching, academic service and recognition."
>
  <section class="section academic-index">
    <div class="container">
      <PageIntro title={`About ${profile.displayName}`}>
        <p slot="description">{profile.phd.role} at {profile.phd.institution}, Japan, and {profile.lecturer.role} at {profile.lecturer.institution}, Indonesia.</p>
      </PageIntro>

      <div class="about-photo-intro">
        <img class="profile-photo" src={localPath('/images/arif-profile.webp')} width="240" height="300" alt="Profile portrait supplied for this personal website" loading="lazy" decoding="async" />
        <div>
          <p>I am a PhD student at Kanazawa University and a lecturer at Universitas Amikom Purwokerto. My doctoral program is in the Graduate School of Natural Science and Technology, Division of Electrical, Information and Communication Engineering.</p>
          <p>{profile.researchFocus} My earlier work includes mathematics education, computer science, software development, and higher-education quality assurance.</p>
          <p>Explore <a href={localPath('/research/')}>Research</a>, <a href={localPath('/projects/')}>Research Projects</a> and <a href={localPath('/publications/')}>Publications</a> for the scholarly work itself.</p>
        </div>
      </div>

      <section aria-labelledby="about-background" class="about-directory">
        <h2 id="about-background">Academic background and activities</h2>
        <p>Explore each subject on its own page, rather than in a single long curriculum vitae.</p>
        <AcademicProfileNav />
      </section>

      <div class="about-bottom">
        <section aria-labelledby="about-focus">
          <h2 id="about-focus">Current research interests</h2>
          <ul>
            {profile.researchAreas.map(area => <li>{area}</li>)}
          </ul>
        </section>
        <aside aria-labelledby="about-profiles">
          <h2 id="about-profiles">Academic profiles</h2>
          <ul>
            <li><a href={profile.profiles.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></li>
            <li><a href={profile.profiles.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a></li>
            <li><a href={profile.profiles.researchGate} target="_blank" rel="noopener noreferrer">ResearchGate ↗</a></li>
          </ul>
          <p><a href={localPath('/contact/')}>Contact →</a></p>
        </aside>
      </div>
    </div>
  </section>
</Layout>
<style>
  .about-photo-intro { display:flex; align-items:flex-start; gap:1.5rem; padding-bottom:1.8rem; border-bottom:1px solid var(--border-color); }
  .about-photo-intro img { width:138px; height:138px; }
  .about-photo-intro > div { max-width:72ch; min-width:0; }
  .about-photo-intro p { font-size:.98rem; line-height:1.8; margin:0 0 .85rem; }
  .about-photo-intro p:last-child { margin-bottom:0; }
  .about-directory { margin:2.2rem 0; }
  .about-directory h2, .about-bottom h2 { font-size:clamp(1.3rem,2.1vw,1.6rem); margin:0 0 .7rem; }
  .about-directory > p { font-size:.93rem; color:var(--text-secondary); margin:0 0 1rem; }
  .about-bottom { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(230px,.6fr); gap:2.5rem; padding-top:1.8rem; border-top:1px solid var(--border-color); }
  .about-bottom ul { margin:.7rem 0 0; padding-left:1.2rem; }
  .about-bottom li { color:var(--text-secondary); font-size:.9rem; line-height:1.65; margin:.45rem 0; }
  .about-bottom aside p { margin:1rem 0; font-size:.9rem; }
  @media(max-width:700px) { .about-bottom { grid-template-columns:1fr; gap:1.5rem; } }
  @media(max-width:500px) { .about-photo-intro { flex-direction:column; gap:1rem; } .about-photo-intro img { width:112px; height:112px; } }
</style>
