---
import { localPath } from '../../lib/urls';
const destination = localPath('/rss.xml');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <title>Moved — RSS Feed</title>
    <link rel="canonical" href={new URL(destination, Astro.site)} />
  </head>
  <body><main><p>This page has moved. <a href={destination}>Continue to RSS Feed</a>.</p></main></body>
</html>
