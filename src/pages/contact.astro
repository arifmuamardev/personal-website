---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { profile } from '../data/profile';
---

<Layout
  title="Contact"
  description="Professional contact details and academic profile links for Arif Mu'amar Wahid."
>
  <section class="section academic-index">
    <div class="container container-narrow">
      <PageIntro title="Contact">
        <p slot="description">For research collaboration, academic correspondence, or teaching-related inquiries.</p>
      </PageIntro>

      <div class="contact-grid">
        <div class="contact-card card">
          <div class="contact-method">
            <div class="method-icon" aria-hidden="true">✉</div>
            <div class="method-details">
              <h2>Professional Email</h2>
              <p><a href={`mailto:${profile.emails.primary}`} id="email-address">{profile.emails.primary}</a></p>
              <button class="btn btn-secondary btn-sm" id="copy-email-btn" type="button">Copy Email Address</button>
              <span id="copy-status" class="sr-only" aria-live="polite"></span>
            </div>
          </div>

          <div class="contact-method">
            <div class="method-icon" aria-hidden="true">⌖</div>
            <div class="method-details">
              <h2>Doctoral Affiliation</h2>
              <p>{profile.phd.institution}, {profile.phd.location}</p>
            <p>{profile.phd.school} · {profile.phd.division}</p>
            </div>
          </div>

          <div class="contact-method">
            <div class="method-icon" aria-hidden="true">▣</div>
            <div class="method-details">
              <h2>Lecturer Affiliation</h2>
              <p>{profile.lecturer.institution}, {profile.lecturer.location}</p>
            </div>
          </div>
        </div>

        <div class="academic-profiles card">
          <h2>Academic Profiles</h2>
          <div class="profile-links-list">
            <a href={profile.profiles.scholar} target="_blank" rel="noopener" class="profile-link">Google Scholar</a>
            <a href={profile.profiles.orcid} target="_blank" rel="noopener" class="profile-link">ORCID</a>
            <a href={profile.profiles.researchGate} target="_blank" rel="noopener" class="profile-link">ResearchGate</a>
            <a href={profile.profiles.github} target="_blank" rel="noopener" class="profile-link">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const emailAddr = document.getElementById('email-address');
  const status = document.getElementById('copy-status');

  if (copyBtn && emailAddr && status) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailAddr.textContent || '');
        status.textContent = 'Email address copied to clipboard.';
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied';
        window.setTimeout(() => {
          copyBtn.textContent = originalText;
          status.textContent = '';
        }, 2000);
      } catch {
        status.textContent = 'Copy failed. Please select the email address manually.';
      }
    });
  }
</script>

<style>
  .container-narrow { max-width: 800px; }

.lead-text { font-size: 1.15rem; text-align: center; max-width: 700px; margin: 0 auto 3.5rem; color: var(--text-secondary); }
  .contact-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2rem; }
  .contact-card, .academic-profiles { margin-bottom: 0; padding: 2.25rem; }
  .contact-method { display: flex; gap: 1.25rem; margin-bottom: 2rem; }
  .contact-method:last-child { margin-bottom: 0; }
  .method-icon { font-size: 1.4rem; line-height: 1; color: var(--accent-color); }
  .method-details h2 { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .method-details p { font-size: 0.95rem; margin-bottom: 0.5rem; }
  .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; border-radius: 6px; }
  .academic-profiles h2 { font-size: 1.35rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; }
  .profile-links-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .profile-link { display: block; padding: 0.8rem 1rem; border: 1px solid var(--border-color); border-radius: var(--border-radius); background: var(--bg-primary); color: var(--text-primary); font-weight: 600; }
  .profile-link:hover { border-color: var(--accent-color); color: var(--accent-color); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
