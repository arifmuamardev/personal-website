---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { localPath } from '../lib/urls';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const publications = await getCollection('publications');
const publicationById = new Map(publications.map(publication => [publication.id, publication]));
const focusProjectIds = ['plant-bioelectrical-potential-edge-sensing', 'plant-bioelectric-transformer-classifier'];
const focusProjects = focusProjectIds
  .map(id => projects.find(project => project.id === id))
  .filter((project): project is (typeof projects)[number] => Boolean(project));
const completedProjects = projects
  .filter(project => project.data.status === 'Completed')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Research" description="Current doctoral research by Arif Mu'amar Wahid on plant bioelectric potentials, signal acquisition, time-series learning and reproducible evaluation, with linked published work.">
  <section class="section academic-index research-page">
    <div class="container">
      <PageIntro title="Research">
        <p slot="description">Plant bioelectric potentials, signal analysis, and reliable machine learning—alongside earlier applied-AI collaborations.</p>
      </PageIntro>

      <nav class="research-navigation" aria-label="Research page sections">
        <a href="#doctoral-focus">Doctoral focus</a>
        <a href="#research-outputs">Projects &amp; outputs</a>
        <a href="#previous-studies">Earlier studies</a>
        <a href={localPath('/publications/')}>All publications ↗</a>
      </nav>

      <div class="research-content">
        <section id="doctoral-focus" class="research-block" aria-labelledby="doctoral-focus-heading">
          <p class="research-kicker">Current work · Kanazawa University</p>
          <h2 id="doctoral-focus-heading">Doctoral research focus</h2>
          <p class="research-lead">{profile.researchFocus}</p>
          <p>My research examines how plant electrical recordings can be acquired, processed, and evaluated consistently. Biological signals are affected by electrode placement, experimental conditions, baseline drift, and noise; these issues shape what machine-learning results can reliably tell us.</p>

          <ol class="research-steps" aria-label="Research workflow">
            <li>
              <span class="step-number" aria-hidden="true">01</span>
              <div><h3>Measurement &amp; acquisition</h3><p>Examine recording configurations, electrodes, reference placement, and experimental context.</p></div>
            </li>
            <li>
              <span class="step-number" aria-hidden="true">02</span>
              <div><h3>Preprocessing &amp; representation</h3><p>Study drift and noise management, signal preparation, and representations for biological time series.</p></div>
            </li>
            <li>
              <span class="step-number" aria-hidden="true">03</span>
              <div><h3>Learning &amp; evaluation</h3><p>Investigate sequence models, transfer learning, and reproducible validation without overstating generalization.</p></div>
            </li>
          </ol>
          <p class="scope-note"><strong>Research scope:</strong> Multisite sensing, environmental context, and edge applications are directions under investigation—not claims of a completed multi-plant deployment or validated real-world system.</p>
        </section>

        <section id="research-outputs" class="research-block" aria-labelledby="research-outputs-heading">
          <div class="research-block-heading">
            <h2 id="research-outputs-heading">Projects &amp; published evidence</h2>
            <a href={localPath('/projects/')}>All projects →</a>
          </div>
          <p>These ongoing research projects connect questions and methods to their associated publications. A paper link identifies a documented research output; it does not imply that every proposed system component has been built.</p>
          <div class="research-projects">
            {focusProjects.map(project => {
              const outputs = project.data.publications
                .map(id => publicationById.get(id))
                .filter((publication): publication is (typeof publications)[number] => Boolean(publication))
                .sort((a, b) => b.data.year - a.data.year);
              return (
                <article class="research-project" aria-labelledby={'research-project-' + project.id}>
                  <p class="research-project-meta">{project.data.status} · {project.data.institution}</p>
                  <h3 id={'research-project-' + project.id}>
                    <a href={localPath('/projects/#' + project.id)}>{project.data.title} →</a>
                  </h3>
                  {project.data.question && <p><strong>Research question:</strong> {project.data.question}</p>}
                  {project.data.approach && <p><strong>Approach:</strong> {project.data.approach}</p>}
                  {outputs.length > 0 && (
                    <div class="research-outputs">
                      <h4>Associated publications</h4>
                      <ul>
                        {outputs.map(pub => (
                          <li>
                            <a href={localPath('/publications/' + pub.id + '/')}>{pub.data.title}</a>
                            <span class="output-metadata">{pub.data.year} · {pub.data.status}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>

        {completedProjects.length > 0 && (
          <section id="previous-studies" class="research-block" aria-labelledby="previous-studies-heading">
            <h2 id="previous-studies-heading">Earlier &amp; collaborative studies</h2>
            <p>My wider research has also involved applied machine learning in other domains. These are distinct from my current doctoral focus.</p>
            <ul class="previous-projects">
              {completedProjects.map(project => (
                <li>
                  <h3><a href={localPath('/projects/#' + project.id)}>{project.data.title} →</a></h3>
                  <p>{project.data.summary}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="research-next">For a complete bibliography, see <a href={localPath('/publications/')}>Publications</a>. For appointments and earlier funded-project participation, see <a href={localPath('/experience/')}>Experience</a>. <a href={localPath('/contact/')}>Get in touch →</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .research-navigation { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .7rem 1.35rem; margin: -2.1rem 0 2.7rem; font-size: .85rem; font-weight: 600; }
  .research-navigation a { text-decoration: underline; text-decoration-color: var(--border-color); text-underline-offset: 4px; }
  .research-navigation a:hover { color: var(--accent-color); text-decoration-color: currentColor; }
  .research-content { max-width: 860px; margin: 0 auto; }
  .research-block { padding: 0 0 2.7rem; margin-bottom: 2.8rem; border-bottom: 1px solid var(--border-color); scroll-margin-top: 6rem; }
  .research-block h2 { font-size: clamp(1.3rem, 2.4vw, 1.85rem); line-height: 1.3; margin: 0 0 1rem; }
  .research-block > p { max-width: 74ch; line-height: 1.75; color: var(--text-secondary); font-size: .96rem; }
  .research-kicker { text-transform: uppercase; font-size: .74rem !important; font-weight: 700; letter-spacing: .07em; color: var(--accent-color) !important; margin-bottom: .65rem; }
  .research-lead { color: var(--text-primary) !important; font-size: 1.08rem !important; font-weight: 550; }
  .research-steps { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
  .research-steps li { border-top: 2px solid var(--border-color); padding: 1rem .25rem 0 0; }
  .step-number { color: var(--accent-color); font-size: .75rem; font-weight: 700; }
  .research-steps h3 { font-family: var(--font-sans); font-size: .96rem; line-height: 1.45; margin: .35rem 0 .35rem; }
  .research-steps p { color: var(--text-secondary); font-size: .85rem; line-height: 1.65; margin: 0; }
  .scope-note { padding: .9rem 1rem; border-left: 3px solid var(--accent-color); background: var(--accent-light); font-size: .87rem !important; }
  .research-block-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .6rem 1.5rem; }
  .research-block-heading a { font-size: .86rem; font-weight: 600; }
  .research-project { padding: 1.35rem 0; border-bottom: 1px solid var(--border-color); }
  .research-project:last-child { border-bottom: 0; }
  .research-project-meta { text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-size: .74rem !important; font-weight: 650; margin: 0 0 .5rem !important; }
  .research-project h3, .previous-projects h3 { font-family: var(--font-sans); font-size: 1.06rem; line-height: 1.45; margin: 0 0 .8rem; }
  .research-project h3 a, .previous-projects h3 a { text-decoration: underline; text-decoration-color: var(--border-color); text-underline-offset: 4px; }
  .research-project h3 a:hover, .previous-projects h3 a:hover { color: var(--accent-color); text-decoration-color: currentColor; }
  .research-project > p { font-size: .91rem; line-height: 1.7; margin: 0 0 .55rem; color: var(--text-secondary); }
  .research-project > p strong { color: var(--text-primary); }
  .research-outputs { margin-top: 1rem; }
  .research-outputs h4 { font-size: .8rem; color: var(--text-muted); margin: 0 0 .5rem; }
  .research-outputs ul { padding-left: 1.2rem; margin: 0; }
  .research-outputs li { margin: .5rem 0; line-height: 1.6; font-size: .87rem; }
  .research-outputs li a { text-decoration: underline; text-underline-offset: 3px; }
  .output-metadata { display: block; color: var(--text-muted); font-size: .77rem; margin-top: .08rem; }
  .previous-projects { list-style: none; padding: 0; margin: 1rem 0 0; }
  .previous-projects li { padding: 1rem 0; border-bottom: 1px solid var(--border-color); }
  .previous-projects li:last-child { border-bottom: 0; }
  .previous-projects h3 { margin-bottom: .4rem; }
  .previous-projects p { color: var(--text-secondary); font-size: .89rem; line-height: 1.65; margin: 0; }
  .research-next { font-size: .9rem; line-height: 1.75; color: var(--text-secondary); margin: -.5rem 0 2rem; }
  .research-next a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 700px) {
    .research-navigation { justify-content: flex-start; margin-top: -1.25rem; margin-bottom: 2rem; gap: .75rem 1.15rem; }
    .research-steps { grid-template-columns: 1fr; gap: .65rem; }
    .research-steps li { display: grid; grid-template-columns: 1.6rem 1fr; gap: .45rem; padding-top: .75rem; }
    .research-steps h3 { margin-top: 0; }
    .research-block { margin-bottom: 2rem; padding-bottom: 2rem; }
  }
</style>
