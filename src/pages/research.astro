---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { localPath } from '../lib/urls';
import { publicCv } from '../data/public-cv';
import { getCollection } from 'astro:content';

const researchProjects = await getCollection('projects');
const publications = await getCollection('publications');
const publicationById = new Map(publications.map(publication => [publication.id, publication]));
const focusProjectIds = ['plant-bioelectrical-potential-edge-sensing', 'plant-bioelectric-transformer-classifier'];
const focusProjects = researchProjects
  .filter(project => focusProjectIds.includes(project.id))
  .sort((a, b) => focusProjectIds.indexOf(a.id) - focusProjectIds.indexOf(b.id));
---

<Layout title="Research" description="Current doctoral research and supporting research themes of Arif Mu'amar Wahid, centered on plant bioelectric signals and machine learning.">
  <section class="section academic-index">
    <div class="container">
      <PageIntro title="Research Activities">
        <p slot="description">Investigating plant bioelectric measurements, signal processing, and machine-learning methods, with selected applied AI research.</p>
      </PageIntro>
      <p class="research-jump"><a href={localPath('/projects/')}>Explore research projects &rarr;</a> <span aria-hidden="true">·</span> <a href={localPath('/publications/')}>Browse publications &rarr;</a></p>

      <div class="research-layout">
        <!-- Main Research Areas -->
        <div class="research-section">
          <h2>Primary PhD Research</h2>
          <div class="research-theme card primary-highlight">
            <span class="theme-label badge">Current doctoral research</span>
            <h3>Decoding Plant Bioelectric Potentials &amp; Electrophysiology</h3>
            <p>
              Plants generate electrical signals (bioelectric potentials) in response to environmental stimuli like temperature shifts, light changes, mechanical wounding, and moisture stress. My primary PhD research focuses on developing and evaluating acquisition, signal-processing, and machine-learning approaches to model and classify these signals.
            </p>
            <p>
              This involves:
            </p>
            <ul class="styled-list">
              <li><strong>Noise and Drift Management:</strong> Evaluating preprocessing, filtering, and baseline-drift handling for slow, low-voltage biological signals.</li>
              <li><strong>Multivariate Representation:</strong> Modeling spatial-temporal electrical patterns across multiple measurement sites using multisensor fusion.</li>
              <li><strong>Time-Series Classification:</strong> Evaluating machine-learning and deep-learning approaches, including Transformer-based models, for noisy biological time-series data.</li>
            </ul>
          </div>

          <section class="focus-evidence" aria-labelledby="focus-evidence-heading">
            <h2 id="focus-evidence-heading">Research projects and published work</h2>
            <p class="research-evidence-intro">The research questions and approaches below come from the curated project records. Linked papers identify publications associated with each project; they do not imply that every proposed sensing component has been deployed or validated.</p>
            <div class="focus-project-list">
              {focusProjects.map(project => {
                const outputs = project.data.publications
                  .map(id => publicationById.get(id))
                  .filter(Boolean)
                  .sort((a,b) => (b?.data.year ?? 0) - (a?.data.year ?? 0));
                return (
                  <article class="focus-project" aria-labelledby={`focus-${project.id}`}>
                    <p class="focus-project-status">Active research · {project.data.institution}</p>
                    <h3 id={`focus-${project.id}`}><a href={localPath(`/projects/#${project.id}`)}>{project.data.title} ↗</a></h3>
                    {project.data.question && <p><strong>Question:</strong> {project.data.question}</p>}
                    {project.data.approach && <p><strong>Approach:</strong> {project.data.approach}</p>}
                    {outputs.length > 0 && (
                      <div class="focus-outputs">
                        <h4>Related publications</h4>
                        <ul>
                          {outputs.map(pub => pub && (
                            <li><a href={localPath(`/publications/${pub.id}/`)}>{pub.data.title}</a> <span>({pub.data.year}, {pub.data.status})</span></li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
            <p class="research-funding-cta"><a href={localPath('/projects/')}>View all research projects →</a></p>
          </section>

          <h2>Core Research Themes</h2>
          
          <div class="research-theme card">
            <div class="theme-icon" aria-hidden="true">🌱</div>
            <h3>Plant Bioelectric Signals</h3>
            <p>
              Focuses on the acquisition, denoising, mathematical modeling, and classification of electrical potential differences in vascular plants. By exploring these bioelectric responses, we seek to build edge-sensing systems that treat plants as natural biosensors for agricultural and environmental monitoring.
            </p>
          </div>

          <div class="research-theme card">
            <div class="theme-icon" aria-hidden="true">📈</div>
            <h3>Biological Time-Series Machine Learning</h3>
            <p>
              Studying machine-learning and deep-learning methodologies that can handle the specific difficulties of biological signals. Unlike synthetic or financial time-series, biological signals are slow, non-stationary, and exhibit severe baseline wander and high variance across individuals.
            </p>
          </div>

          <div class="research-theme card">
            <div class="theme-icon" aria-hidden="true">⛅</div>
            <h3>Multisensor Environmental Monitoring</h3>
            <p>
              Integrating environmental context data with plant electrophysiology to study how environmental conditions relate to bioelectric responses.
            </p>
          </div>

          <div class="research-theme card">
            <div class="theme-icon" aria-hidden="true">🧠</div>
            <h3>Applied Artificial Intelligence</h3>
            <p>
              Applying computer vision and tabular machine learning to diverse fields including medical diagnostics (such as malaria detection in microscopy smears using GAN-augmented datasets), educational marketing segmentation, landslide susceptibility mapping, and cybersecurity.
            </p>
          </div>

          <h2>Research Experience and Funded Projects</h2>
          <p class="research-funding-intro">The following 2024 projects are recorded in my comprehensive academic CV as funded research experience. Participation is listed without assuming a principal-investigator role.</p>
          <div class="research-funding">
            {publicCv.fundedResearch.map(item => (
              <div class="funded-entry">
                <h3>{item.title}</h3>
                <p>{item.sponsor} · {item.year}</p>
              </div>
            ))}
          </div>
          <p class="research-funding-cta"><a href={localPath('/experience/')}>Academic & professional experience →</a></p>
        </div>

        <!-- Sidebar for distinction of interests -->
        <div class="research-sidebar">
          <div class="sidebar-block card">
            <h3>Research Status</h3>
            
            <div class="status-group">
              <span class="status-indicator active"></span>
              <h4>Primary Focus (Current)</h4>
              <p>Plant electrophysiology and time-series modeling (PhD Thesis, Kanazawa University).</p>
            </div>

            <div class="status-group">
              <span class="status-indicator supporting"></span>
              <h4>Supporting Interests</h4>
              <p>Transfer learning, generative augmentation, applied computer vision, and multisensor environmental logging.</p>
            </div>

            <div class="status-group">
              <span class="status-indicator past"></span>
              <h4>Previous Research</h4>
              <p>Accreditation database schemas (Zachman Framework), data warehouses, and web theme recommendations using convolutional neural networks.</p>
            </div>
          </div>
          
          <div class="sidebar-block card">
            <h3>Current Academic Institutions</h3>
            <ul class="styled-list">
              <li>Kanazawa University, Japan</li>
              <li>Universitas Amikom Purwokerto, Indonesia</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .focus-evidence { margin-top: 2.1rem; }
  .research-evidence-intro { max-width: 70ch; font-size: .93rem !important; line-height: 1.75; }
  .focus-project-list { border-top: 1px solid var(--border-color); }
  .focus-project { padding: 1.3rem 0; border-bottom: 1px solid var(--border-color); }
  .focus-project-status { color: var(--text-muted); font-size: .74rem !important; font-weight: 650; text-transform: uppercase; letter-spacing: .045em; margin: 0 0 .5rem !important; }
  .focus-project h3 { font-family: var(--font-sans); font-size: 1.07rem; margin-bottom: .65rem; line-height: 1.5; }
  .focus-project h3 a { color: var(--text-primary); text-decoration: underline; text-decoration-color: var(--border-color); text-underline-offset: 3px; }
  .focus-project h3 a:hover { color: var(--accent-color); text-decoration-color: var(--accent-color); }
  .focus-project p { font-size: .88rem !important; line-height: 1.7; margin-bottom: .5rem !important; }
  .focus-outputs { margin: .85rem 0 0; }
  .focus-outputs h4 { font-size: .8rem; color: var(--text-muted); margin-bottom: .35rem; }
  .focus-outputs ul { padding-left: 1.1rem; }
  .focus-outputs li { color: var(--text-secondary); line-height: 1.6; font-size: .86rem; margin: .35rem 0; }
  .focus-outputs a { text-decoration: underline; text-underline-offset: 3px; }
  .focus-outputs span { font-size: .76rem; color: var(--text-muted); }
  .research-jump { display:flex; justify-content:center; gap:1rem; flex-wrap:wrap; margin:-2.3rem auto 2.5rem; font-weight:600; }

.lead-text {
    font-size: 1.15rem;
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
    color: var(--text-secondary);
  }
  
  .research-funding-intro {font-size:.95rem;line-height:1.75;color:var(--text-secondary);}
  .research-funding {border-top:1px solid var(--border-color);}
  .funded-entry {padding:.9rem 0;border-bottom:1px solid var(--border-color);}
  .funded-entry h3 {font-family:var(--font-sans);font-size:1rem;margin:0 0 .3rem;line-height:1.5;}
  .funded-entry p {font-size:.86rem;margin:0;color:var(--text-muted);}
  .research-funding-cta {font-size:.9rem;margin:1rem 0 0;}
  .research-layout {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 3rem;
  }
  
  .research-section h2 {
    margin-top: 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5rem;
  }
  
  .primary-highlight {
    border-left: 4px solid var(--accent-color);
    background: var(--accent-light);
  }
  
  .theme-label {
    background-color: var(--accent-color);
    color: var(--accent-foreground);
    margin-bottom: 1rem;
  }
  
  .research-theme {
    margin-bottom: 1.5rem;
  }
  
  .research-theme h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }
  
  .research-theme p {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }
  
  .theme-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  
  .research-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .sidebar-block h3 {
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }
  
  .status-group {
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
    position: relative;
  }
  
  .status-indicator {
    position: absolute;
    left: 0;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  
  .status-indicator.active {
    background-color: hsl(145, 80%, 40%);
    box-shadow: 0 0 8px hsl(145, 80%, 40%);
  }
  
  .status-indicator.supporting {
    background-color: var(--accent-color);
  }
  
  .status-indicator.past {
    background-color: var(--text-muted);
  }
  
  .status-group h4 {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }
  
  .status-group p {
    font-size: 0.85rem;
    margin-bottom: 0;
    color: var(--text-secondary);
  }
  
  .styled-list {
    list-style: none;
  }
  
  .styled-list li {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    position: relative;
    padding-left: 1.25rem;
  }
  
  .styled-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent-color);
    font-weight: bold;
  }
  
  @media (max-width: 768px) {
    .research-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
