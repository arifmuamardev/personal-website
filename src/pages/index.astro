---
import Layout from '../layouts/Layout.astro';
import PublicationAuthors from '../components/PublicationAuthors.astro';
import { getCollection } from 'astro:content';
import { localPath } from '../lib/urls';
import { profile } from '../data/profile';

const publications = await getCollection('publications');
const researchProjects = await getCollection('projects');
const posts = await getCollection('blog');

const featuredPublications = publications
  .filter(pub => pub.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999) || b.data.year - a.data.year)
  .slice(0, 3);

const selectedResearch = researchProjects
  .filter(project => project.data.featured)
  .slice(0, 3);

const recentWriting = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);
---
<Layout title="Home" description="Arif Mu'amar Wahid: PhD student at Kanazawa University, lecturer at Universitas Amikom Purwokerto, and developer working on plant bioelectric signals, machine learning, and software.">
  <section class="intro container" aria-labelledby="home-name">
    <img class="identity-portrait profile-photo" src={localPath('/images/arif-profile.webp')} width="240" height="300" alt="Profile portrait supplied for this personal website" fetchpriority="high" decoding="async" />
    <div class="identity-copy">
      <p class="identity-eyebrow">Researcher · Educator · Software developer</p>
      <h1 id="home-name">{profile.displayName}</h1>
      <p class="identity-affiliations">
        {profile.phd.role}, {profile.phd.institution}, Japan
        <span class="identity-break" aria-hidden="true"> · </span>
        {profile.lecturer.role}, {profile.lecturer.institution}, Indonesia
      </p>
      <p class="identity-bio">{profile.researchSummary} I also develop web applications and software tools for practical workflows.</p>
      <p class="identity-recognition">MEXT Scholarship recipient · 2nd place, Indoneris Data Mining Competition (2024)</p>
      <nav class="identity-links" aria-label="Key profile links">
        <a href={localPath('/research/')}>Research</a>
        <a href={localPath('/publications/')}>Publications</a>
        <a href={localPath('/blog/')}>Writing</a>
        <a href={localPath('/cv/')}>CV</a>
        <a href={localPath('/contact/')}>Contact</a>
      </nav>
      <div class="identity-external" aria-label="Academic and development profiles">
        <a href={profile.profiles.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>
        <a href={profile.profiles.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a>
        <a href={profile.profiles.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
  </section>

  <div class="container homepage-content">
    <section class="academic-section" aria-labelledby="selected-publications">
      <div class="section-heading">
        <h2 id="selected-publications">Selected publications</h2>
        <a href={localPath('/publications/')}>Full publication list →</a>
      </div>
      {featuredPublications.length > 0 ? (
        <ol class="editorial-list publication-list">
          {featuredPublications.map(pub => (
            <li class="publication-row">
              <span class="row-year">{pub.data.year}</span>
              <div>
                <h3><a href={localPath(`/publications/${pub.id}/`)}>{pub.data.title}</a></h3>
                <p class="row-authors"><PublicationAuthors authors={pub.data.authors} /></p>
                <p class="row-details">{pub.data.venue}</p>
                {pub.data.doi && <a class="row-extra" href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer">DOI ↗</a>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p>Publication details are available in the <a href={localPath('/publications/')}>complete bibliography</a>.</p>
      )}
    </section>

    <section class="academic-section" aria-labelledby="research-areas">
      <div class="section-heading">
        <h2 id="research-areas">Research interests</h2>
        <a href={localPath('/research/')}>Research overview →</a>
      </div>
      <p class="section-intro">My work focuses on data-driven analysis of biological and other complex signals, with particular attention to how measurements and models can be validated.</p>
      <div class="interest-list">
        <div class="interest-row"><strong>Plant bioelectric signals</strong><p>Plant electrophysiology, potential variations, and responses to environmental stimuli.</p></div>
        <div class="interest-row"><strong>Machine learning for time series</strong><p>Classification, sequence modeling, and reproducible evaluation of biological signal data.</p></div>
        <div class="interest-row"><strong>Applied intelligent systems</strong><p>Multisensor measurement, data mining, and useful computational tools.</p></div>
      </div>
      {selectedResearch.length > 0 && (
        <div class="research-projects">
          <h3>Selected research projects</h3>
          <ul>
            {selectedResearch.map(project => (
              <li>
                <strong>{project.data.title}</strong>
                <span>{project.data.summary}</span>
              </li>
            ))}
          </ul>
          <a href={localPath('/projects/')}>Explore all research projects →</a>
        </div>
      )}
    </section>

    <section class="academic-section" aria-labelledby="writing-heading">
      <div class="section-heading">
        <h2 id="writing-heading">Recent writing</h2>
        <a href={localPath('/blog/')}>All articles →</a>
      </div>
      <ul class="editorial-list">
        {recentWriting.map(post => (
          <li class="writing-row">
            <time datetime={post.data.publishedDate.toISOString()}>{post.data.publishedDate.toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric'})}</time>
            <div>
              <h3><a href={localPath(`/${post.id}/`)}>{post.data.title}</a></h3>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 174px minmax(0,1fr);
    gap: clamp(26px, 5vw, 52px);
    align-items: start;
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .identity-portrait {
    width: 174px;
    height: 174px;
  }
  .identity-copy { min-width: 0; }
  .identity-eyebrow { color: var(--text-muted); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 650; margin: 0 0 .65rem; }
  .identity-copy h1 { font-size: clamp(2.3rem, 4.4vw, 3.6rem); letter-spacing: -.04em; line-height: 1.13; margin: 0 0 .75rem; }
  .identity-affiliations { font-size: .98rem; color: var(--text-primary); font-weight: 550; line-height: 1.75; margin: 0 0 1.1rem; }
  .identity-bio { font-size: 1.04rem; line-height: 1.78; max-width: 70ch; margin-bottom: 1.2rem; }
  .identity-recognition {font-size:.83rem;color:var(--text-muted);line-height:1.65;margin:-.3rem 0 1.2rem;}
  .identity-links, .identity-external { display:flex; flex-wrap:wrap; column-gap: 1.25rem; row-gap: .35rem; }
  .identity-links { margin-bottom: .9rem; }
  .identity-links a { font-size: .88rem; font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }
  .identity-external a { font-size: .81rem; color: var(--text-muted); text-decoration: underline; text-underline-offset: 3px; }
  .identity-external a:hover { color: var(--accent-color); }
  .homepage-content { border-top: 1px solid var(--border-color); }
  .academic-section { padding-block: clamp(2.65rem, 5vw, 3.8rem); border-bottom: 1px solid var(--border-color); }
  .academic-section:last-child { border-bottom: 0; }
  .section-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; margin-bottom: 1.4rem; }
  .section-heading h2 { margin: 0; font-size: clamp(1.55rem, 2.5vw, 1.9rem); }
  .section-heading > a { flex: 0 0 auto; font-size: .84rem; font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }
  .section-intro { max-width: 72ch; font-size: .98rem; line-height: 1.75; margin: 0 0 1.35rem; }
  .editorial-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border-color); }
  .editorial-list > li { padding: 1rem 0; border-bottom: 1px solid var(--border-color); }
  .editorial-list h3 { margin: 0 0 .4rem; font-size: 1.07rem; font-family: var(--font-sans); font-weight: 650; line-height: 1.45; }
  .editorial-list h3 a { color: var(--text-primary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; }
  .editorial-list h3 a:hover, .editorial-list h3 a:focus-visible { color: var(--accent-color); text-decoration-color: currentColor; }
  .editorial-list p { font-size: .88rem; line-height: 1.68; margin: .25rem 0; }
  .publication-row { display: grid; grid-template-columns: 66px minmax(0,1fr); gap: 20px; }
  .row-year { padding-top: .15rem; font-size: .82rem; font-weight: 700; color: var(--text-muted); }
  .row-authors { color: var(--text-secondary); }
  .row-details { color: var(--text-muted); font-size: .83rem!important; }
  .row-extra { font-size: .8rem; font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }
  .interest-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(13px,2vw,25px); padding: 1rem 0 1.35rem; }
  .interest-row { border-top: 2px solid var(--border-color); padding-top: .8rem; }
  .interest-row strong { font-size: .95rem; font-weight: 700; }
  .interest-row p { font-size: .88rem; line-height: 1.7; margin: .5rem 0 0; }
  .research-projects { border-top: 1px solid var(--border-color); padding-top: 1.4rem; margin-top: 1.2rem; }
  .research-projects h3 { font-size: 1.09rem; font-family: var(--font-sans); margin: 0 0 .6rem; }
  .research-projects ul { list-style: none; padding: 0; margin: 0 0 .8rem; }
  .research-projects li { padding: .65rem 0; }
  .research-projects li strong { font-size: .9rem; display: block; }
  .research-projects li span { font-size: .87rem; color: var(--text-secondary); display: block; margin-top: .15rem; }
  .research-projects > a { font-size: .86rem; font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }
  .software-row { display:flex; gap: 1rem; align-items: flex-start; justify-content: space-between; }
  .software-row > div { max-width: 78ch; }
  .row-caution { font-size: .82rem!important; color: var(--text-muted); }
  .writing-row { display:grid;grid-template-columns: 128px minmax(0,1fr);gap:22px; }
  .writing-row time { font-size: .81rem; color: var(--text-muted); padding-top: .16rem; }
  @media(max-width:700px){
    .intro { grid-template-columns: 1fr; gap: 1.2rem; padding-top: 2.4rem; }
    .identity-portrait { width: 112px; height: 112px; }
    .identity-break { display: block; font-size: 0; height: 0; }
    .identity-copy h1 { font-size: clamp(2.15rem, 9vw, 2.8rem); }
    .section-heading { align-items: flex-start; flex-wrap: wrap; gap: .5rem; }
    .section-heading > a { width: 100%; }
    .interest-list { grid-template-columns: 1fr; gap: .9rem; }
    .publication-row { grid-template-columns: 1fr; gap: .2rem; }
    .writing-row { grid-template-columns: 1fr; gap: .3rem; }
  }
</style>
