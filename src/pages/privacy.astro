---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout title="Privacy Policy">
  <section class="section academic-index">
    <div class="container container-narrow">
      <PageIntro title="Privacy Policy">
        <p slot="description">Last updated: October 2026. This is the personal academic website of Arif Mu'amar Wahid.</p>
      </PageIntro>

      <div class="card privacy-content">
        <h2>Data Collection &amp; Analytics</h2>
        <p>
          This personal academic website does not currently include a visitor account system, tracking cookies, commercial analytics scripts, or third-party advertising networks. External services linked here may have their own data practices.
        </p>

        <h2>Server Logs</h2>
        <p>
          GitHub Pages and infrastructure providers may process technical request information, including IP addresses, for hosting, security and diagnostics. This website does not directly collect or retain those server logs. Refer to the providers for retention and processing details.
        </p>

        <h2>External Links</h2>
        <p>
          This site contains outbound links to academic publishers, repositories, and indexing platforms (including Google Scholar, ORCID, ResearchGate, GitHub, and DOI resolvers). When navigating to external domains, their respective privacy terms and cookie policies apply.
        </p>

        <h2>Contact</h2>
        <p>
          If you have any questions regarding this website, you can reach out via academic email at:
          <a href="mailto:arif@amikompurwokerto.ac.id">arif@amikompurwokerto.ac.id</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .privacy-content {
    padding: 2.5rem;
    margin-top: 2rem;
  }
  
  .privacy-content h2 {
    font-size: 1.35rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }
  
  .privacy-content h2:first-of-type {
    margin-top: 0;
  }
  
  .privacy-content p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  
  .privacy-content a {
    color: var(--accent-color);
    text-decoration: underline;
  }
</style>
