---
import { localPath } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const allPublications = await getCollection('publications');
const publicationById = new Map(allPublications.map(pub => [pub.id, pub]));

const statusRank: Record<string, number> = { Active: 0, Completed: 1, Paused: 2, Archived: 3 };
const sortedProjects = allProjects.sort((a, b) =>
  (statusRank[a.data.status] ?? 9) - (statusRank[b.data.status] ?? 9) || a.data.title.localeCompare(b.data.title)
);
---

<Layout
  title="Projects"
  description="Research projects by Arif Mu'amar Wahid, including plant bioelectric signal research, machine learning, medical imaging, and geohazard applications."
>
  <section class="section academic-index">
    <div class="container">
      <PageIntro title="Research Projects">
        <p slot="description">Selected current and completed research activities, linked to publications where available.</p>
      </PageIntro>

      <div class="projects-list">
        {sortedProjects.map(project => {
          const linkedPubs = project.data.publications
            .map(id => publicationById.get(id))
            .filter(Boolean);
          return (
            <article class="project-detail-card card">
              <div class="project-header-row">
                <h2>{project.data.title}</h2>
                <span class={`status-badge badge ${project.data.status.toLowerCase()}`}>{project.data.status}</span>
              </div>

              <p class="project-meta">
                {project.data.role && <><strong>Role:</strong> {project.data.role}</>}
                {project.data.institution && <><span class="meta-sep" aria-hidden="true">•</span><strong>Institution:</strong> {project.data.institution}</>}
              </p>

              <p class="project-summary-text">{project.data.summary}</p>

              {project.data.collaborators.length > 0 && (
                <div class="project-section-detail">
                  <strong>Collaborators:</strong> {project.data.collaborators.join(', ')}
                </div>
              )}

              {linkedPubs.length > 0 && (
                <div class="project-section-detail">
                  <strong>Related publication{linkedPubs.length > 1 ? 's' : ''}:</strong>
                  <ul class="publication-links">
                    {linkedPubs.map(pub => pub && <li><a href={localPath(`/publications/${pub.id}/`)}>{pub.data.title}</a></li>)}
                  </ul>
                </div>
              )}

              <div class="project-tech-row" aria-label="Methods and technologies">
                {project.data.technologies.map(tech => <span class="tech-badge badge">{tech}</span>)}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>

.lead-text { font-size: 1.1rem; text-align: center; max-width: 760px; margin: 0 auto 3.5rem; color: var(--text-secondary); }
  .projects-list { display: flex; flex-direction: column; gap: 2rem; }
  .project-detail-card { padding: 2.25rem; }
  .project-header-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 0.75rem; }
  .project-header-row h2 { font-size: 1.6rem; margin-bottom: 0; line-height: 1.25; }
  .project-meta { font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem; }
  .meta-sep { color: var(--text-muted); margin: 0 0.5rem; }
  .project-summary-text { font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.25rem; }
  .project-section-detail { font-size: 0.95rem; margin-bottom: 1.25rem; color: var(--text-secondary); }
  .publication-links { margin: 0.5rem 0 0 1.25rem; }
  .publication-links li { margin-bottom: 0.35rem; }
  .project-tech-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .status-badge.active { background: hsl(145, 35%, 90%); color: hsl(145, 80%, 25%); }
  .status-badge.completed { background: hsl(210, 30%, 90%); color: hsl(210, 80%, 28%); }
  .tech-badge { background: var(--accent-light); color: var(--accent-color); border: 1px solid var(--border-color); }
  :global(html[data-theme="dark"]) .status-badge.active { background: hsl(145, 30%, 16%); color: hsl(145, 65%, 72%); }
  :global(html[data-theme="dark"]) .status-badge.completed { background: hsl(210, 28%, 17%); color: hsl(210, 70%, 75%); }
  @media (max-width: 768px) { .project-header-row { flex-direction: column; gap: 0.5rem; } }
</style>
