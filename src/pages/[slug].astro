---
import { localPath } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageBreadcrumb from '../components/PageBreadcrumb.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(post => !post.data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Calculate reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Find related posts (exclude current, match category or at least one tag)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && !p.data.draft)
  .filter(p => p.data.category === post.data.category || p.data.tags.some(t => post.data.tags.includes(t)))
  .slice(0, 2);

// Find previous and next posts
const activePosts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => a.data.publishedDate.getTime() - b.data.publishedDate.getTime()); // Oldest to newest
  
const currentIndex = activePosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? activePosts[currentIndex - 1] : null;
const nextPost = currentIndex < activePosts.length - 1 ? activePosts[currentIndex + 1] : null;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": new URL(localPath('/og-image.png'), Astro.site || 'https://arifmuamardev.github.io').toString(),
  "datePublished": post.data.publishedDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Person",
    "name": "Arif Mu'amar Wahid",
    "url": new URL(localPath('/'), Astro.site || "https://arifmuamardev.github.io").toString(),
    "logo": {
      "@type": "ImageObject",
      "url": new URL(localPath('/favicon.svg'), Astro.site || 'https://arifmuamardev.github.io').toString()
    }
  },
  "url": new URL(Astro.url.pathname, Astro.site || 'https://arifmuamardev.github.io').toString()
};
---


<Layout 
  title={post.data.title} 
  description={post.data.description}
  type="article"
>
  <script type="application/ld+json" is:raw set:html={JSON.stringify(articleSchema)} />
  <article class="post-detail-section">
    <div class="container container-narrow">
      <PageBreadcrumb parent="Writing" parentPath="/blog/" current={post.data.title} />
      <header class="post-header">
        <div class="post-meta-details">
          <time datetime={post.data.publishedDate.toISOString()}>
            {post.data.publishedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span class="meta-sep">&bull;</span>
          <span class="read-time">{readingTime} min read</span>
          <span class="meta-sep">&bull;</span>
          <span class="post-category badge">{post.data.category}</span>
        </div>
        
        <h1 class="post-title">{post.data.title}</h1>
        
        <div class="post-author">
          <span class="author-label">Written by</span>
          <span class="author-name">{post.data.author}</span>
        </div>
      </header>

      <!-- Main Body Markdown Content -->
      <div class="post-body">
        <Content />
      </div>

      <!-- Tags list -->
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          <span class="tags-label">Tags:</span>
          {post.data.tags.map(tag => (
            <span class="tag-badge badge">#{tag}</span>
          ))}
        </div>
      )}

      <!-- Prev/Next Navigation -->
      <nav class="post-navigation-nav">
        <div class="nav-prev">
          {prevPost && (
            <a href={localPath(`/${prevPost.id}/`)}>
              <span class="nav-direction">&larr; Previous</span>
              <span class="nav-post-title">{prevPost.data.title}</span>
            </a>
          )}
        </div>
        <div class="nav-next">
          {nextPost && (
            <a href={localPath(`/${nextPost.id}/`)}>
              <span class="nav-direction">Next &rarr;</span>
              <span class="nav-post-title">{nextPost.data.title}</span>
            </a>
          )}
        </div>
      </nav>

      <!-- Related Posts Section -->
      {relatedPosts.length > 0 && (
        <section class="related-posts-section">
          <h2>Related Posts</h2>
          <div class="related-grid">
            {relatedPosts.map(rp => (
              <div class="related-card card">
                <h3><a href={localPath(`/${rp.id}/`)}>{rp.data.title}</a></h3>
                <p>{rp.data.description}</p>
                <a href={localPath(`/${rp.id}/`)} class="read-link" aria-label={`Read related article: ${rp.data.title}`}>Read Article &rarr;</a>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>

<style>
  .post-detail-section {
    padding: 4.5rem 0;
  }
  
  .container-narrow {
    max-width: 700px;
  }
  
  .post-header {
    margin-bottom: 2.5rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }
  
  .post-meta-details {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  
  .meta-sep {
    margin: 0 0.5rem;
  }
  
  .post-title {
    font-size: 2.75rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
    letter-spacing: -0.03em;
  }
  
  .post-author {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
  
  .author-label {
    color: var(--text-muted);
    margin-right: 0.25rem;
  }
  
  .author-name {
    font-weight: 500;
    color: var(--text-primary);
  }
  
  /* Markdown Content Styling overrides */
  .post-body :global(p) {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.75rem;
    color: var(--text-secondary);
  }
  
  .post-body :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .post-body :global(h3) {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .post-body :global(ul), .post-body :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }
  
  .post-body :global(li) {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }
  
  .post-body :global(a) {
    color: var(--accent-color);
    text-decoration: underline;
  }
  
  .post-body :global(a:hover) {
    color: var(--accent-hover);
  }

  .post-body :global(blockquote) {
    border-left: 4px solid var(--accent-color);
    padding-left: 1.5rem;
    margin-left: 0;
    margin-bottom: 1.75rem;
    font-style: italic;
    color: var(--text-muted);
  }
  
  .post-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 3rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }
  
  .tags-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-right: 0.5rem;
  }
  
  .post-navigation-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  
  .nav-prev, .nav-next {
    width: 50%;
  }
  
  .nav-prev a, .nav-next a {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    background-color: var(--bg-secondary);
    transition: var(--transition-smooth);
    height: 100%;
  }
  
  .nav-next a {
    align-items: flex-end;
    text-align: right;
  }
  
  .nav-prev a:hover, .nav-next a:hover {
    border-color: var(--accent-color);
    transform: translateY(-2px);
    background-color: var(--bg-primary);
  }
  
  .nav-direction {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }
  
  .nav-post-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }
  
  .related-posts-section {
    border-top: 1px solid var(--border-color);
    padding-top: 3rem;
  }
  
  .related-posts-section h2 {
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }
  
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  
  .related-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  
  .related-card h3 a {
    color: var(--text-primary);
  }
  
  .related-card h3 a:hover {
    color: var(--accent-color);
  }
  
  .related-card p {
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  
  .read-link {
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  @media (max-width: 600px) {
    .post-navigation-nav {
      flex-direction: column;
    }
    
    .nav-prev, .nav-next {
      width: 100%;
    }
    
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
