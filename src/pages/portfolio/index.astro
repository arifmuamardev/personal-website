---
import Layout from '../../layouts/Layout.astro';
import { localPath } from '../../lib/urls';
import { softwareProjects } from '../../data/software-projects';
---
<Layout title="Software Portfolio" description="Selected software engineering projects and web applications by Arif Mu'amar Wahid, with architecture, case studies, and source code.">
  <section class="section portfolio-intro">
    <div class="container portfolio-container">
      <div class="portfolio-heading">
        <div>
          <p class="eyebrow">Building things that matter</p>
          <h1>Software Portfolio<span class="heading-dot" aria-hidden="true">.</span></h1>
          <p class="portfolio-lead">I build and study practical web systems—bridging software engineering, data, and the realities of how people use technology.</p>
        </div>
        <div class="portfolio-context">
          <span class="context-index">01 / Portfolio</span>
          <p>Selected work, with the implementation, constraints, and evidence kept visible.</p>
        </div>
      </div>
      <div class="portfolio-divider" aria-hidden="true"></div>
      <p class="portfolio-note">Each project distinguishes its implemented source code from a working public demo. Screens below are architecture illustrations, not screenshots of a live application.</p>

      <div class="portfolio-grid">
        {softwareProjects.map((project, index) => (
          <article class="software-card">
            <div class="software-layout">
              <div class="software-copy">
                <div class="software-top">
                  <span class="project-index">{String(index + 1).padStart(2, '0')} / Software</span>
                  <span class="software-stage">{project.status}</span>
                </div>
                <h2><a href={localPath(project.caseStudy)}>{project.title}</a></h2>
                <p class="software-subtitle">{project.subtitle}</p>
                <p class="project-description">{project.summary}</p>
                <div class="tags" aria-label="Technology stack">
                  {project.technologies.map(tech => <span class="tech-tag">{tech}</span>)}
                </div>
                <div class="software-actions">
                  <a class="btn btn-primary" href={localPath(project.caseStudy)}>Explore case study <span aria-hidden="true">→</span></a>
                  <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">Source on GitHub <span aria-hidden="true">↗</span></a>
                </div>
                <p class="software-note">{project.note}</p>
              </div>
              <figure class="software-illustration">
                <div class="illustration-header">
                  <span class="illustration-mark" aria-hidden="true"></span>
                  <span>System structure</span>
                  <span class="illustration-type">CONCEPT</span>
                </div>
                <ol class="workflow-steps">
                  {project.workflow.map((step, i) => (
                    <li>
                      <span class="step-number">{String(i + 1).padStart(2, '0')}</span>
                      <span class="step-name">{step}</span>
                      {i < project.workflow.length - 1 && <span class="step-arrow" aria-hidden="true">↓</span>}
                    </li>
                  ))}
                </ol>
                <figcaption>Illustrative workflow · not an application screenshot</figcaption>
              </figure>
            </div>
          </article>
        ))}
      </div>
      <aside class="portfolio-future">
        <div>
          <p class="eyebrow">Next chapters</p>
          <h2>More projects will follow.</h2>
        </div>
        <p>New case studies will be added when their implementation and demonstration are ready. Private tools and personal data stay outside this public portfolio.</p>
      </aside>
    </div>
  </section>
</Layout>
<style>
  .portfolio-container { max-width: 1100px; }
  .portfolio-intro { padding-top: 4.5rem; }
  .portfolio-heading { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 3rem; align-items: end; }
  .eyebrow { color: var(--accent-color); text-transform: uppercase; font-size: .78rem; font-weight: 700; letter-spacing: .12em; margin-bottom: 1rem; }
  h1 { font-size: clamp(2.55rem, 5.6vw, 4.4rem); letter-spacing: -.04em; max-width: 13ch; }
  .heading-dot { color: var(--accent-color); }
  .portfolio-lead { font-size: clamp(1.07rem, 1.8vw, 1.3rem); max-width: 660px; margin-top: 1.2rem; }
  .portfolio-context { border-left: 2px solid var(--accent-color); padding-left: 1rem; }
  .portfolio-context p { font-size: .85rem; margin: .5rem 0 0; }
  .context-index { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; color: var(--accent-color); }
  .portfolio-divider { height: 1px; background: var(--border-color); margin: 2.2rem 0 1.4rem; }
  .portfolio-note { max-width: 760px; font-size: .94rem; color: var(--text-muted); }
  .portfolio-grid { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  .software-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; overflow: hidden; }
  .software-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); align-items: stretch; }
  .software-copy { padding: clamp(1.5rem, 4vw, 2.7rem); min-width: 0; }
  .software-top { display:flex; justify-content:space-between; gap: .75rem; align-items:center; margin-bottom: 1.5rem; flex-wrap:wrap; }
  .project-index { color:var(--accent-color); font-size:.74rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .software-stage { font-size:.78rem; color:var(--text-secondary); border:1px solid var(--border-color); padding:.28rem .68rem; border-radius:50px; }
  .software-card h2 { font-size: clamp(2.3rem, 4vw, 3.3rem); margin:0 0 .3rem; letter-spacing:-.035em; }
  .software-card h2 a { color: var(--text-primary); }
  .software-card h2 a:hover { color: var(--accent-color); }
  .software-subtitle { font-weight:650; color: var(--text-primary); margin-bottom:1.25rem; }
  .project-description { max-width: 53ch; }
  .tags { display:flex; flex-wrap:wrap; gap:.45rem; margin:1.3rem 0 1.7rem; }
  .tech-tag { font-size:.77rem; color:var(--text-secondary); background:var(--bg-primary); border:1px solid var(--border-color); padding:.3rem .7rem; border-radius:50px; }
  .software-actions { display:flex; gap:1.1rem; align-items:center; flex-wrap:wrap; }
  .text-link { font-size:.92rem; font-weight:600; }
  .software-note { font-size:.82rem; margin:1.3rem 0 0; color:var(--text-muted); }
  .software-illustration { background:var(--bg-primary); margin:0; border-left:1px solid var(--border-color); min-width:0; padding:1.7rem; display:flex; flex-direction:column; justify-content:center; gap:1rem; }
  .illustration-header { display:flex; align-items:center; gap:.5rem; color:var(--text-secondary); font-size:.8rem; font-weight:650; }
  .illustration-mark { width:8px; height:8px; background:var(--accent-color); border-radius:50%; }
  .illustration-type { margin-left:auto; color:var(--text-muted); font-size:.65rem; letter-spacing:.12em; }
  .workflow-steps { list-style:none; display:grid; gap:.75rem; padding:1rem 0; }
  .workflow-steps li { background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:12px; padding:.8rem 1rem; display:flex; align-items:center; gap:.85rem; box-shadow:var(--shadow-sm); position:relative; }
  .step-number { font-size:.76rem; color:var(--accent-color); font-weight:800; }
  .step-name { font-size:.87rem; font-weight:600; }
  .step-arrow { position:absolute; bottom:-19px; left:1rem; color:var(--accent-color); z-index:2; font-weight:800; }
  figcaption { color:var(--text-muted); font-size:.74rem; line-height:1.5; }
  .portfolio-future { display:flex; gap:3rem; justify-content:space-between; align-items:center; border-top:1px solid var(--border-color); margin-top:3rem; padding-top:2.5rem; }
  .portfolio-future h2 { font-size:clamp(1.5rem, 2.4vw, 2.1rem); }
  .portfolio-future p:last-child { max-width:420px; font-size:.94rem; margin:0; }
  @media (max-width:780px) {
    .portfolio-heading { grid-template-columns:1fr; gap:.5rem; }
    .portfolio-context { display:none; }
    .software-layout { grid-template-columns:1fr; }
    .software-illustration { border-left:0; border-top:1px solid var(--border-color); padding:1.5rem; }
    .software-copy { padding:1.6rem; }
    .portfolio-future { flex-direction:column; align-items:flex-start; gap:.7rem; }
  }
</style>
