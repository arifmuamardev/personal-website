---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { localPath } from '../../lib/urls';
import { softwareProjects } from '../../data/software-projects';
---
<Layout title="Software Portfolio" description="Selected software engineering projects by Arif Mu'amar Wahid, including their implementations, case studies, and current demonstration status.">
  <section class="section academic-index">
    <div class="container">
      <PageIntro title="Software Portfolio">
        <p slot="description">Selected web applications and engineering projects. Each case study describes the problem, implementation, and limitations, with source code where available.</p>
      </PageIntro>
      <div class="portfolio-items">
        {softwareProjects.map(project => (
          <article class="portfolio-item">
            <div class="portfolio-item-heading">
              <div>
                <p class="item-kind">{project.category}</p>
                <h2><a href={localPath(project.caseStudy)}>{project.title}</a></h2>
                <p class="item-subtitle">{project.subtitle}</p>
              </div>
              <span class="item-status">{project.status}</span>
            </div>
            <p>{project.summary}</p>
            <p class="item-technologies">{project.technologies.join(' · ')}</p>
            <div class="item-links">
              <a href={localPath(project.caseStudy)}>Read case study →</a>
              <a href={project.repository} target="_blank" rel="noopener noreferrer">Source code ↗</a>
            </div>
            <p class="item-note">{project.note}</p>
          </article>
        ))}
      </div>
      <p class="portfolio-bottom-note">Additional case studies will be added when their implementations and supporting evidence are ready. Private applications and personal data are not included in this public portfolio.</p>
    </div>
  </section>
</Layout>
<style>
  .portfolio-items { border-top:1px solid var(--border-color); }
  .portfolio-item { padding:1.7rem 0 2rem; border-bottom:1px solid var(--border-color); }
  .portfolio-item-heading {display:flex;justify-content:space-between;align-items:flex-start;gap:1.25rem;flex-wrap:wrap;}
  .item-kind {font-size:.75rem;text-transform:uppercase;letter-spacing:.09em;color:var(--text-muted);font-weight:700;margin:0 0 .5rem;}
  .portfolio-item h2 {font-size:clamp(1.4rem,2.5vw,1.9rem);margin:0 0 .2rem;}
  .portfolio-item h2 a {color:var(--text-primary);text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;}
  .portfolio-item h2 a:hover {color:var(--accent-color);text-decoration-color:currentColor;}
  .item-subtitle {font-size:.94rem;color:var(--text-secondary);margin:0;}
  .item-status {font-size:.8rem;padding:.3rem .7rem;border:1px solid var(--border-color);border-radius:99px;color:var(--text-muted);}
  .portfolio-item>p {max-width:75ch;font-size:.94rem;line-height:1.73;margin:1.1rem 0 .6rem;}
  .item-technologies {font-size:.84rem!important;color:var(--text-muted)!important;}
  .item-links {display:flex;gap:1.1rem;flex-wrap:wrap;font-size:.87rem;font-weight:650;margin-top:1rem;}
  .item-links a {text-decoration:underline;text-underline-offset:3px;}
  .portfolio-item .item-note {font-size:.81rem;color:var(--text-muted);margin-bottom:0;}
  .portfolio-bottom-note {max-width:72ch;padding-top:1.35rem;font-size:.86rem;color:var(--text-muted);line-height:1.7;}
</style>