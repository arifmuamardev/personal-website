---
import Layout from '../../layouts/Layout.astro';
import { localPath } from '../../lib/urls';
import { softwareProjects } from '../../data/software-projects';
---
<Layout title="Software Portfolio" description="Selected software engineering projects and web applications by Arif Mu'amar Wahid, with architecture, case studies, and source code.">
  <section class="section portfolio-intro">
    <div class="container">
      <p class="eyebrow">Software Engineering</p>
      <h1>Software Portfolio</h1>
      <p class="portfolio-lead">Beyond academic research, I build useful web applications with a focus on maintainable architecture, thoughtful user experience, and data integrity.</p>
      <p class="portfolio-note">Projects have different stages of readiness. Source code, demo availability, and deployment status are documented separately rather than implied.</p>
      <div class="portfolio-grid">
        {softwareProjects.map(project => (
          <article class="software-card card">
            <div class="software-top">
              <span class="badge">{project.category}</span>
              <span class="software-stage">{project.status}</span>
            </div>
            <h2><a href={localPath(project.caseStudy)}>{project.title}</a></h2>
            <p class="software-subtitle">{project.subtitle}</p>
            <p>{project.summary}</p>
            <div class="tags">{project.technologies.map(tech => <span class="badge" >{tech}</span>)}</div>
            <div class="software-actions">
              <a class="btn btn-primary" href={localPath(project.caseStudy)}>Read case study →</a>
              <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">View repository ↗</a>
            </div>
            <p class="software-note">{project.note}</p>
          </article>
        ))}
      </div>
      <aside class="portfolio-future">
        <h2>More in progress</h2>
        <p>Future application case studies will be added as their features, privacy safeguards, and demonstrations are ready. Private internal tools are not listed by default.</p>
      </aside>
    </div>
  </section>
</Layout>
<style>
  .portfolio-intro { padding-top: 4rem; }
  .eyebrow { color: var(--accent-color); text-transform: uppercase; font-size: .78rem; font-weight: 700; letter-spacing: .12em; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.7rem); }
  .portfolio-lead { font-size: 1.2rem; max-width: 730px; }
  .portfolio-note { max-width: 730px; font-size: .92rem; color: var(--text-muted); }
  .portfolio-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .software-card { padding: 2.2rem; }
  .software-top { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.5rem; margin-bottom:1.2rem; }
  .software-stage { font-size: .8rem; color:var(--text-muted); }
  .software-card h2 { margin-bottom:.35rem; }
  .software-subtitle { font-weight: 600; }
  .tags { display:flex; gap:.45rem; flex-wrap:wrap; margin:1.2rem 0; }
  .tags .badge { background:var(--accent-light); border:1px solid var(--border-color); }
  .software-actions { display:flex; gap:1.1rem; align-items:center; flex-wrap:wrap; }
  .software-note { font-size:.85rem; margin:1.2rem 0 0; color:var(--text-muted); }
  .portfolio-future { border-top:1px solid var(--border-color); margin-top:3rem; padding-top:2rem; }
</style>
