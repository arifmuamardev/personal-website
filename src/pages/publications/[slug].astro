---
import { localPath } from '../../lib/urls';
import Layout from '../../layouts/Layout.astro';
import PageBreadcrumb from '../../components/PageBreadcrumb.astro';
import PublicationReference from '../../components/PublicationReference.astro';
import PublicationAuthors from '../../components/PublicationAuthors.astro';
import PublicationMeta from '../../components/PublicationMeta.astro';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map(publication => ({
    params: { slug: publication.id },
    props: { publication },
  }));
}

const { publication } = Astro.props;
const data = publication.data;
// Reverse lookup: the project collection remains the single source of truth
// for which publications are associated with each research project.
const researchProjects = await getCollection('projects');
const relatedProjects = researchProjects.filter(project => project.data.publications.includes(publication.id));
const hasExternalLinks = Boolean(data.doi || data.publisherUrl || data.scholarUrl || data.pdf || data.code || data.dataset);
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://arifmuamardev.github.io').toString();
const creativeType = data.type === 'Book' ? 'Book' : data.type === 'Book Chapter' ? 'Chapter' : 'ScholarlyArticle';
const publicationSchema = {
  '@context': 'https://schema.org',
  '@type': creativeType,
  name: data.title,
  headline: data.title,
  author: data.authors.map((name: string) => ({ '@type': 'Person', name })),
  datePublished: String(data.year),
  isPartOf: data.venue ? { '@type': 'CreativeWork', name: data.venue } : undefined,
  description: data.abstract || `${data.type} by ${profile.name}, published in ${data.year}.`,
  identifier: data.doi ? `https://doi.org/${data.doi}` : undefined,
  sameAs: data.doi ? `https://doi.org/${data.doi}` : data.publisherUrl,
  url: pageUrl,
};
---

<Layout
  title={data.title}
  description={data.abstract || `${data.type} by ${profile.name}, ${data.year}. ${data.venue}`}
>
  <script type="application/ld+json" is:raw set:html={JSON.stringify(publicationSchema)} />
  <article class="section publication-detail">
    <div class="container container-narrow">
      <PageBreadcrumb parent="Publications" parentPath="/publications/" current={data.title} />

      <header class="publication-header">
        <PublicationMeta type={data.type} status={data.status} year={data.year} researchArea={data.researchArea} tags={data.tags} />
        <h1>{data.title}</h1>
        <p class="authors"><PublicationAuthors authors={data.authors} /></p>
        <PublicationReference publication={data} />
      </header>

      <section class="detail-section ieee-citation-section" aria-labelledby="ieee-heading">
        <h2 id="ieee-heading">Recommended IEEE-style citation</h2>
        <PublicationReference publication={data} includeTitle={true} />
        <p class="citation-note">Only available bibliographic fields are shown. Missing volume, issue, page or article number details are not inferred from the title or DOI.</p>
      </section>

      {data.abstract && (
        <section class="detail-section" aria-labelledby="abstract-heading">
          <h2 id="abstract-heading">Abstract</h2>
          <p>{data.abstract}</p>
        </section>
      )}

      {relatedProjects.length > 0 && (
        <section class="detail-section related-research" aria-labelledby="related-research-heading">
          <h2 id="related-research-heading">Related research projects</h2>
          <p class="related-research-note">These projects reference this work as a related publication.</p>
          <ul>
            {relatedProjects.map(project => (
              <li>
                <a href={localPath(`/projects/#${project.id}`)}>{project.data.title} →</a>
                <span>{project.data.status} · {project.data.role || 'Research contributor'}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {hasExternalLinks && (<section class="detail-section" aria-labelledby="links-heading">
        <h2 id="links-heading">Publication Links</h2>
        <div class="links">
          {data.doi && <a class="btn btn-primary" href={`https://doi.org/${data.doi}`} target="_blank" rel="noopener">Open DOI</a>}
          {data.publisherUrl && <a class="btn btn-secondary" href={data.publisherUrl} target="_blank" rel="noopener">Publisher</a>}
          {data.scholarUrl && <a class="btn btn-secondary" href={data.scholarUrl} target="_blank" rel="noopener">Google Scholar</a>}
          {data.pdf && <a class="btn btn-secondary" href={data.pdf} target="_blank" rel="noopener">PDF</a>}
          {data.code && <a class="btn btn-secondary" href={data.code} target="_blank" rel="noopener">Code</a>}
          {data.dataset && <a class="btn btn-secondary" href={data.dataset} target="_blank" rel="noopener">Dataset</a>}
        </div>
      </section>)}

      {data.doi && (
        <section class="detail-section citation-box" aria-labelledby="doi-heading">
          <h2 id="doi-heading">DOI</h2>
          <code>{data.doi}</code>
        </section>
      )}

      <p class="back-link"><a href={localPath('/publications/')}>← Back to all publications</a></p>
    </div>
  </article>
</Layout>

<style>
  .related-research-note { font-size: .87rem; color: var(--text-muted); margin: .35rem 0 .7rem; }
  .related-research ul { padding: 0; list-style: none; border-top: 1px solid var(--border-color); }
  .related-research li { padding: .75rem 0; border-bottom: 1px solid var(--border-color); }
  .related-research li a { display: block; font-size: .95rem; font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }
  .related-research li span { display: block; margin-top: .25rem; color: var(--text-muted); font-size: .79rem; }
  .container-narrow { max-width: 760px; }
  .publication-header { border-bottom: 1px solid var(--border-color); padding-bottom: 2rem; margin-bottom: 2.5rem; }
  .publication-header h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; }
  .authors { font-size: .88rem; color: var(--text-muted); margin: 1rem 0 .35rem; line-height: 1.7; }
  .citation-note {font-size:.79rem;color:var(--text-muted);line-height:1.65;margin-top:.65rem;}
  .ieee-citation-section {padding:1rem 1.2rem;background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:8px;}
  .venue { font-style: italic; color: var(--text-muted); margin-bottom: 0; }
  .detail-section { margin: 2.5rem 0; }
  .detail-section h2 { font-size: 1.4rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.45rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .citation-box { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--border-radius); padding: 1.25rem; }
  .citation-box code { overflow-wrap: anywhere; }
  .back-link { margin-top: 3rem; }
</style>
