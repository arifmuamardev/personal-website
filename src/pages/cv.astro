---
import { localPath } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { profile } from '../data/profile';
import { publicCv } from '../data/public-cv';
---

<Layout
  title="Curriculum Vitae"
  description="Academic curriculum vitae of Arif Mu'amar Wahid, including education, current appointments, research interests, experience, and selected awards."
>
  <section class="section academic-index">
    <div class="container container-narrow">
      <PageIntro title="Curriculum Vitae">
        <p slot="description">Academic background, research experience, scholarly contributions, teaching, and selected professional activities. The downloadable public PDF is regenerated from the same curated data and publication index, excluding private contact details.</p>
        <a slot="actions" href={localPath('/files/arif-muamar-cv.pdf')} class="btn btn-primary" download>
          <span aria-hidden="true">↓</span> Download Public PDF
        </a>
      </PageIntro>

      <p class="cv-source-note">These records are curated from my comprehensive CV last updated on 14 August 2026. Published works are synchronized with the publication index. Roles listed as current in that document may have changed subsequently.</p>

      <div class="cv-content">
        <section class="cv-section" aria-labelledby="cv-profile">
          <h2 id="cv-profile">{profile.displayName}</h2>
          <p>
            {profile.phd.role} at {profile.phd.institution}, Japan · {profile.lecturer.role} at {profile.lecturer.institution}, Indonesia<br />
            Email: <a href={`mailto:${profile.emails.primary}`}>{profile.emails.primary}</a>
          </p>
        </section>

        <section class="cv-section" aria-labelledby="cv-research">
          <h2 id="cv-research">Research Interests</h2>
          <ul class="styled-list">{profile.researchAreas.map(area => <li>{area}</li>)}</ul>
        </section>

        <section class="cv-section" aria-labelledby="cv-education">
          <h2 id="cv-education">Education</h2>
          <div class="cv-timeline">
            {profile.education.map(item => (
              <div class="cv-entry">
                <span class="cv-entry-date">{item.period}</span>
                <div class="cv-entry-detail">
                  <h3>{item.degree}</h3>
                  <p>{item.institution}</p>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-experience">
          <h2 id="cv-experience">Academic &amp; Professional Experience</h2>
          <div class="cv-timeline">
            {profile.experience.map(item => (
              <div class="cv-entry">
                <span class="cv-entry-date">{item.period}</span>
                <div class="cv-entry-detail">
                  <h3>{item.role}</h3>
                  <p>{item.institution}</p>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-awards">
          <h2 id="cv-awards">Awards &amp; Scholarships</h2>
          <ul class="styled-list">{profile.awards.map(award => <li>{award}</li>)}</ul>
        </section>

        <section class="cv-section" aria-labelledby="cv-memberships">
          <h2 id="cv-memberships">Professional Memberships</h2>
          <ul class="styled-list">
            {publicCv.memberships.map(item => <li><strong>{item.organization}</strong> — {item.capacity} (since {item.since})</li>)}
          </ul>
        </section>

        <section class="cv-section" aria-labelledby="cv-teaching">
          <h2 id="cv-teaching">Teaching and Technical Competencies</h2>
          <h3>Teaching and student research support</h3>
          <p>{publicCv.teachingAreas.join(' · ')}</p>
          <div class="cv-compact-entries">
            {publicCv.technicalCompetencies.map(item => (
              <div class="cv-compact-entry">
                <h3>{item.name}</h3>
                <p>{item.description}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-leadership">
          <h2 id="cv-leadership">Academic Leadership</h2>
          <div class="cv-compact-entries">
            {publicCv.academicLeadership.map(item => (
              <div class="cv-compact-entry">
                <h3>{item.title}</h3>
                <p>{item.organization} · {item.period}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-service">
          <h2 id="cv-service">Editorial, Reviewing, and Conference Service</h2>
          <p class="cv-context">Service appointments below reflect the August 2026 CV and are not asserted as freshly verified current appointments.</p>
          <div class="cv-compact-entries">
            {publicCv.scholarlyService.map(item => (
              <div class="cv-compact-entry">
                <h3>{item.title}</h3>
                <p>{item.organization} · {item.period}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-presentations">
          <h2 id="cv-presentations">Selected Academic Presentations</h2>
          <div class="cv-compact-entries">
            {publicCv.presentations.map(item => (
              <div class="cv-compact-entry">
                <span class="cv-entry-date">{item.date} · {item.kind}</span>
                <h3>{item.title}</h3>
                <p>{item.event}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-funded">
          <h2 id="cv-funded">Funded Research Experience</h2>
          <p class="cv-context">Projects listed in the master CV; individual awardee or principal-investigator roles are not inferred.</p>
          <div class="cv-compact-entries">
            {publicCv.fundedResearch.map(item => (
              <div class="cv-compact-entry">
                <h3>{item.title}</h3>
                <p>{item.sponsor} · {item.year}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-books">
          <h2 id="cv-books">Books and Chapters</h2>
          <div class="cv-compact-entries">
            {publicCv.books.map(item => (
              <div class="cv-compact-entry">
                <h3>{item.title}</h3>
                <p>{item.kind} · {item.publisher} · {item.year} · ISBN {item.isbn}</p>
              </div>
            ))}
          </div>
          <p class="cv-context">See <a href={localPath('/publications/')}>Publications</a> for the searchable bibliography and available publication links.</p>
        </section>

        <section class="cv-section" aria-labelledby="cv-ip">
          <h2 id="cv-ip">Intellectual Property and Creative Works</h2>
          <div class="cv-compact-entries">
            {publicCv.intellectualProperty.map(item => (
              <div class="cv-compact-entry">
                <h3>{item.title}</h3>
                <p>{item.kind} · {item.year}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="cv-section" aria-labelledby="cv-links">
          <h2 id="cv-links">Academic Profiles</h2>
          <p class="profile-links">
            <a href={profile.profiles.scholar} target="_blank" rel="noopener">Google Scholar</a>
            <span aria-hidden="true"> · </span>
            <a href={profile.profiles.orcid} target="_blank" rel="noopener">ORCID</a>
            <span aria-hidden="true"> · </span>
            <a href={profile.profiles.researchGate} target="_blank" rel="noopener">ResearchGate</a>
          </p>
        </section>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container-narrow { max-width: 850px; }
  .cv-source-note {font-size:.82rem;color:var(--text-muted);line-height:1.7;margin:-.3rem 0 2rem;max-width:72ch;}
  .cv-context {font-size:.88rem;color:var(--text-muted);margin:.1rem 0 1rem;line-height:1.7;}
  .cv-compact-entries {border-top:1px solid var(--border-color);}
  .cv-compact-entry {padding:.9rem 0;border-bottom:1px solid var(--border-color);}
  .cv-compact-entry h3 {font-family:var(--font-sans);font-size:1rem;margin:0 0 .25rem;line-height:1.5;}
  .cv-compact-entry p {font-size:.9rem;margin:0;color:var(--text-secondary);line-height:1.68;}
  .cv-section>h3 {font-family:var(--font-sans);font-size:1.02rem;margin:0 0 .6rem;}

.page-title { margin-bottom: 0; }

.cv-content { display: flex; flex-direction: column; gap: 2.75rem; }
  .cv-section h2 { font-size: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.25rem; color: var(--accent-color); }
  .cv-timeline { border-left: 2px solid var(--border-color); padding-left: 1.5rem; }
  .cv-entry { position: relative; margin-bottom: 1.75rem; }
  .cv-entry::before { content: ''; position: absolute; left: calc(-1.5rem - 6px); top: 6px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent-color); border: 2px solid var(--bg-primary); }
  .cv-entry-date { font-size: 0.85rem; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 0.2rem; }
  .cv-entry-detail h3 { font-size: 1.15rem; margin-bottom: 0.25rem; }
  .cv-entry-detail p { font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .styled-list { padding-left: 1.2rem; }
  .styled-list li { margin-bottom: 0.65rem; color: var(--text-secondary); }
  .profile-links { margin-bottom: 0; }
  @media (max-width: 600px) { .cv-header-row { align-items: flex-start; } }
</style>
