---
import { localPath } from '../lib/urls';
import '../styles/global.css';
import { profile, personJsonLd } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { 
  title, 
  description = "Academic website of Arif Mu'amar Wahid: PhD student at Kanazawa University and lecturer at Universitas Amikom Purwokerto, researching plant bioelectric signals and machine learning.",
  image = "/og-image.png",
  type = 'website',
  noindex = false
} = Astro.props;

const imageURL = new URL(/^https?:\/\//.test(image) ? image : localPath(image), Astro.site || 'https://arifmuamardev.github.io');

// Determine current URL (with trailing slash)
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://arifmuamardev.github.io');

const siteRoot = Astro.site || new URL('https://arifmuamardev.github.io');
const personSchema = { ...personJsonLd, url: new URL(localPath('/'), siteRoot).toString() };
const isProduction = import.meta.env.PUBLIC_SITE_MODE === 'production';
const academicRoutes = ['/about/', '/education/', '/experience/', '/teaching/', '/academic-service/', '/recognition/'];
const isAcademicPage = academicRoutes.some(route => Astro.url.pathname.startsWith(localPath(route)));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/svg+xml" href={localPath('/favicon.svg')} />
    <link rel="icon" href={localPath('/favicon.ico')} />
    <link rel="manifest" href={localPath('/site.webmanifest')} />
    <meta name="theme-color" content="#ffffff" />
    <!-- Apply the saved/system color scheme before painting to avoid a theme flash. -->
    <script is:inline>
      (() => {
        const key = 'amw-color-theme';
        let saved = null;
        try { saved = localStorage.getItem(key); } catch { /* storage may be blocked */ }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved === 'dark' || saved === 'light'
          ? saved
          : (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#141c20' : '#ffffff');
      })();
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title} — Arif Mu'amar Wahid</title>
    <meta name="title" content={`${title} — Arif Mu'amar Wahid`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Arif Muamar Writing" href={localPath('/rss.xml')} />
    
    <!-- Temporary Indexing Restrictions (Offline Review/Staging Mode) -->
    <meta name="robots" content={isProduction && !noindex ? 'index, follow' : 'noindex, nofollow'} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — Arif Mu'amar Wahid`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content="Arif Mu'amar Wahid Academic Profile" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} — Arif Mu'amar Wahid`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    <meta property="twitter:image:alt" content="Arif Mu'amar Wahid Academic Profile" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:raw set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <!-- Accessibility: Skip to main content -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Header / Navigation -->
    <header class="site-header">
      <div class="container nav-wrapper">
        <a href={localPath('/')} class="logo" aria-label="Arif Mu’amar Wahid — Home">
          <span class="logo-name">{profile.displayName}</span>
          <span class="logo-subtitle">Research · Publications · Writing</span>
        </a>
        
        <div class="header-actions">
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Toggle light and dark appearance">
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z" />
            </svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
            <span data-theme-label>Light</span>
          </button>
          <!-- Accessible mobile menu toggle -->
          <button id="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="main-nav">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="12" x2="20" y2="12" class="line-mid"></line>
            <line x1="4" y1="6" x2="20" y2="6" class="line-top"></line>
            <line x1="4" y1="18" x2="20" y2="18" class="line-bot"></line>
          </svg>
          </button>
        </div>
        
        <nav id="main-nav" aria-label="Main Navigation">
          <ul>
            <li><a href={localPath('/about/')} class={isAcademicPage ? 'active' : ''} aria-current={Astro.url.pathname.startsWith(localPath('/about/')) ? 'page' : undefined}>About</a></li>
            <li><a href={localPath('/research/')} class={(Astro.url.pathname.startsWith(localPath('/research/')) || Astro.url.pathname.startsWith(localPath('/projects/'))) ? 'active' : ''} aria-current={Astro.url.pathname.startsWith(localPath('/research/')) ? 'page' : undefined}>Research</a></li>
            <li><a href={localPath('/publications/')} class={Astro.url.pathname.startsWith(localPath('/publications/')) ? 'active' : ''} aria-current={Astro.url.pathname.startsWith(localPath('/publications/')) ? 'page' : undefined}>Publications</a></li>
            <li><a href={localPath('/blog/')} class={Astro.url.pathname.startsWith(localPath('/blog/')) ? 'active' : ''} aria-current={Astro.url.pathname.startsWith(localPath('/blog/')) ? 'page' : undefined}>Writing</a></li>
            <li><a href={localPath('/contact/')} class={Astro.url.pathname.startsWith(localPath('/contact/')) ? 'active' : ''} aria-current={Astro.url.pathname.startsWith(localPath('/contact/')) ? 'page' : undefined}>Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer>
      <div class="container footer-content">
        <p>&copy; {new Date().getFullYear()} {profile.displayName}. All rights reserved.</p>
        <p class="footer-sub">
          {profile.phd.role}, {profile.phd.institution} &amp; {profile.lecturer.role}, {profile.lecturer.institution}.
        </p>
        <div class="footer-links">
          <a href={profile.profiles.scholar} target="_blank" rel="noopener" aria-label="Google Scholar Profile">Scholar</a>
          <span class="sep">&bull;</span>
          <a href={profile.profiles.orcid} target="_blank" rel="noopener" aria-label="ORCID Profile">ORCID</a>
          <span class="sep">&bull;</span>
          <a href={profile.profiles.researchGate} target="_blank" rel="noopener" aria-label="ResearchGate Profile">ResearchGate</a>
          <span class="sep">&bull;</span>
          <a href={profile.profiles.github} target="_blank" rel="noopener" aria-label="GitHub Profile">GitHub</a>
          <span class="sep">&bull;</span>
          <a href={localPath('/privacy/')}>Privacy</a>
        </div>
      </div>
    </footer>

    <!-- Theme preference: explicit choice persists, otherwise follow system setting. -->
    <script>
      const themeButton = document.querySelector('[data-theme-toggle]');
      const themeLabel = themeButton?.querySelector('[data-theme-label]');
      const themeRoot = document.documentElement;
      const themeKey = 'amw-color-theme';
      const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
      const updateThemeUI = () => {
        const dark = themeRoot.dataset.theme === 'dark';
        if (themeButton) {
          themeButton.setAttribute('aria-pressed', String(dark));
          themeButton.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        }
        if (themeLabel) themeLabel.textContent = dark ? 'Dark' : 'Light';
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#141c20' : '#ffffff');
      };
      const applyTheme = (theme) => {
        themeRoot.dataset.theme = theme;
        updateThemeUI();
      };
      updateThemeUI();
      themeButton?.addEventListener('click', () => {
        const nextTheme = themeRoot.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(nextTheme);
        try { localStorage.setItem(themeKey, nextTheme); } catch { /* storage may be blocked */ }
      });
      themeMedia.addEventListener('change', () => {
        let stored = null;
        try { stored = localStorage.getItem(themeKey); } catch { /* storage may be blocked */ }
        if (stored !== 'light' && stored !== 'dark') applyTheme(themeMedia.matches ? 'dark' : 'light');
      });
      window.addEventListener('storage', (event) => {
        if (event.key === themeKey) {
          const next = event.newValue === 'dark' || event.newValue === 'light'
            ? event.newValue : (themeMedia.matches ? 'dark' : 'light');
          applyTheme(next);
        }
      });

      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('main-nav');
      
      if (toggle && nav) {
        const closeMenu = () => {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open navigation menu');
          nav.classList.remove('nav-open');
        };
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
          nav.classList.toggle('nav-open', open);
        });
        nav.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) closeMenu();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('nav-open')) {
            closeMenu();
            toggle.focus();
          }
        });
        document.addEventListener('pointerdown', (event) => {
          if (event.target instanceof Node && !nav.contains(event.target) && !toggle.contains(event.target)) closeMenu();
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 1080) closeMenu();
        });
      }
    </script>
  </body>
</html>

<style>
  .nav-wrapper {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  
  .logo {
    display: flex;
    flex-direction: column;
    color: var(--text-primary);
  }
  
  .logo-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  .logo-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .header-actions {
    display: flex;
    align-items: center;
    gap: .55rem;
    flex: 0 0 auto;
    order: 3;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    gap: .45rem;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    padding: .55rem .7rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: .76rem;
    font-weight: 600;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .theme-toggle:hover {
    background: var(--bg-secondary);
    border-color: var(--accent-color);
  }
  .theme-icon-sun { display: none; }
  :global(html[data-theme="dark"]) .theme-icon-moon { display: none; }
  :global(html[data-theme="dark"]) .theme-icon-sun { display: block; }
  .theme-toggle svg { flex: 0 0 auto; }

  #menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }
  
  #main-nav {
    order: 2;
    margin-left: auto;
  }
  #main-nav ul {
    display: flex;
    list-style: none;
    gap: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  
  #main-nav a {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.87rem;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
  }
  
  #main-nav a:hover, #main-nav a.active {
    color: var(--accent-color);
    border-bottom-color: var(--accent-color);
  }
  
  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  
  .footer-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  
  .sep {
    color: var(--border-color);
  }
  
  main {
    outline: none;
  }
  
  @media (max-width: 1080px) {
    #main-nav { order: 4; }
    #menu-toggle {
      display: inline-flex;
    }
    
    #main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: var(--bg-secondary);
      border-bottom: 1px solid var(--border-color);
      padding: 1.5rem;
      box-shadow: var(--shadow-lg);
      max-height: calc(100dvh - 76px);
      overflow-y: auto;
    }
    
    #main-nav.nav-open {
      display: block;
    }
    
    #main-nav ul {
      flex-direction: column;
      gap: 0.25rem;
      align-items: stretch;
    }

    #main-nav a {
      display: block;
      padding: 0.75rem 1rem;
      min-height: 44px;
      border: 0;
      border-radius: 8px;
    }

    #main-nav a.active {
      background: var(--accent-light);
    }
  }

  @media (max-width: 420px) {
    .theme-toggle [data-theme-label] { display: none; }
    .theme-toggle { padding-inline: .65rem; }
  }
</style>
